  "event_type_rules": {
    "_comment": "Maps keyword groups to event_type codes. First match wins.",
    "APPLICATION_OPEN": {
      "title_patterns": [
        "application started", "application open", "form started", "apply now",
        "registration started", "আবেদন শুরু", "ফর্ম শুরু", "আবেদন চলছে"
      ],
      "require_date_signal": false
